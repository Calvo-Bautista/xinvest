# --- Base de datos ---
# Local: archivo SQLite (libSQL). En Vercel: URL de Turso (libsql://xxx.turso.io)
DATABASE_URL=file:./data/xinvest.db
# Solo para Turso
DATABASE_AUTH_TOKEN=

# --- Auth (single-user) ---
# Si APP_PASSWORD está vacío y NODE_ENV != production, la auth queda deshabilitada (solo dev local).
APP_PASSWORD=
# Secreto para firmar la cookie de sesión (mín. 32 chars). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- InvertirOnline (opcional) ---
# Credenciales de tu cuenta IOL (API oficial: https://developers.iolinversiones.com).
# Sólo las lee el server; en la DB se guardan los tokens de sesión, cifrados.
IOL_USERNAME=
IOL_PASSWORD=
# Clave para cifrar los tokens en la DB. Si se omite se usa SESSION_SECRET.
IOL_TOKEN_KEY=
# Secreto del sync diario (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>"). Vacío = sin cron.
CRON_SECRET=
