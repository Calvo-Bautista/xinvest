# --- Base de datos ---
# Local: archivo SQLite (libSQL). En Vercel: URL de Turso (libsql://xxx.turso.io)
DATABASE_URL=file:./data/xinvest.db
# Solo para Turso
DATABASE_AUTH_TOKEN=

# --- Auth (single-user) ---
# Si APP_PASSWORD está vacío y NODE_ENV != production, la auth queda deshabilitada (solo dev local).
APP_PASSWORD=
# Secreto para firmar la cookie de sesión (mín. 32 chars). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Fase 2: InvertirOnline (no usado en el MVP) ---
IOL_USERNAME=
IOL_PASSWORD=
